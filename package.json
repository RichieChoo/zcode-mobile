{
  "name": "zcode-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "preandroid": "bash scripts/adb-restart.sh",
    "android": "expo run:android",
    "build:apk": "npx expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease && mkdir -p ../dist && cp app/build/outputs/apk/release/app-release.apk ../dist/ZCode-Moblie-v0.1.0-release.apk",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "^0.13.3",
    "expo-camera": "~15.0.0",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.3",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-screen-orientation": "~8.0.0",
    "expo-sharing": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-paper": "^5.12.8",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.12.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "typescript": "^5.3.3"
  },
  "private": true
}
