{
  "expo": {
    "name": "ZCode-Moblie",
    "slug": "zcode-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/zcode-icon.png",
    "scheme": "zcode",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#17181B",
      "resizeMode": "contain",
      "image": "./assets/zcode-splash.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.z.zcode.mobile",
      "icon": "./assets/zcode-icon.png",
      "splash": {
        "backgroundColor": "#17181B",
        "resizeMode": "contain",
        "image": "./assets/zcode-splash.png"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "ZCode 需要使用相机扫描桌面端生成的二维码以建立远程连接。",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false
        },
        "UILaunchScreen": {
          "UIColorName": "SplashScreenBackground"
        }
      }
    },
    "android": {
      "package": "ai.z.zcode.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/zcode-adaptive.png",
        "backgroundColor": "#17181B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/zcode-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "ZCode 需要使用相机扫描桌面端生成的二维码以建立远程连接。",
          "recordAudioAndroid": false
        }
      ],
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.1.12297006",
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
